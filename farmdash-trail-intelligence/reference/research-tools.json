          "protocolId": {
            "type": "string",
            "description": "Protocol ID (e.g. \"hyperliquid\")"
          }
        },
        "required": [
          "protocolId"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "get_protocol_risk_factors",
      "inputSchema": {
        "type": "object",
        "properties": {
          "protocolId": {
            "type": "string",
            "description": "Protocol ID to audit"
          }
        },
        "required": [
          "protocolId"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "get_chain_breakdown",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      }
    },
    {
      "name": "get_agent_events",
      "inputSchema": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string"
          },
          "agentAddress": {
            "type": "string",
            "pattern": "^0x[a-fA-F0-9]{40}$"
          },
          "sessionToken": {
            "type": "string",
            "minLength": 32,
            "maxLength": 256
          }
        },
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "get_historical_trailheat",
      "inputSchema": {
        "type": "object",
        "properties": {
          "protocolId": {
            "type": "string"
          },
          "days": {
            "default": 30,
            "type": "integer",
            "minimum": 1,
            "maximum": 365
          }
        },
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "audit_sybil_risk",
      "inputSchema": {
        "type": "object",
        "properties": {
          "addresses": {
            "minItems": 1,
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^0x[a-fA-F0-9]{40}$"
            }
          }
        },
        "required": [
          "addresses"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "simulate_points",
      "inputSchema": {
        "type": "object",
        "properties": {
          "totalVolumeUsd": {
            "type": "number",
            "minimum": 0
          },
          "txCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "daysActive": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "walletBalanceUsd": {
            "type": "number",
            "minimum": 0
          },
          "uniqueContracts": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "isCexFundingOnly": {
            "type": "boolean"
          },
          "protocolPoints": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "number"
            }
          }
        },
        "required": [
          "totalVolumeUsd",
          "txCount",
          "daysActive",
          "walletBalanceUsd",
          "uniqueContracts",
          "isCexFundingOnly",
          "protocolPoints"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "get_wallet_balances",
      "inputSchema": {
        "type": "object",
        "properties": {
          "address": {
            "type": "string",
            "pattern": "^0x[a-fA-F0-9]{40}$"
          },
          "chains": {
            "type": "string"
          }
        },
        "required": [
          "address"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "get_token_prices",
      "inputSchema": {
        "type": "object",
        "properties": {
          "symbols": {
            "type": "string"
          },
          "tokens": {
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 128
            }
          }
        },
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "optimize_portfolio",
      "inputSchema": {
        "type": "object",
        "properties": {
          "currentProtocols": {
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 128
            }
          },
          "riskPreference": {
            "type": "string",
            "enum": [
              "conservative",
              "balanced",
              "aggressive"
            ]
          },
          "chains": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "budget": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          }
        },
        "required": [
          "currentProtocols",
          "riskPreference"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "find_capital_route",
      "inputSchema": {
        "type": "object",
        "properties": {
          "fromChainId": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "toChainId": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "fromToken": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Resolver-supported symbol, native identifier, token address, or chain-qualified asset; discovery resolves canonical assets server-side."
          },
          "toToken": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Resolver-supported symbol, native identifier, token address, or chain-qualified asset; discovery resolves canonical assets server-side."
          },
          "fromAmount": {
            "type": "string",
            "pattern": "^[0-9]+$",
            "description": "Amount in token base units."
          },
          "protocol": {
            "type": "string",
            "enum": [
              "lifi",
              "relay"
            ]
          }
        },
        "required": [
          "fromChainId",
          "toChainId",
          "fromToken",
          "toToken",
          "fromAmount"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    }
  ],
  "verifiedContractCommit": "45196127e861f55fa3fb0e295dc4580a6bdfe4ad",
