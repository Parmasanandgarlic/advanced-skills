{
  "sourceRepository": "hububstudio/farmdashbeta",
  "sourceCommit": "3b6a83dd5bfa239c85b68797bd27651294f335ab",
  "tools": [
    {
      "name": "get_swap_quote",
      "inputSchema": {
        "type": "object",
        "properties": {
          "fromChainId": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "toChainId": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "fromToken": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Resolver-supported symbol, native identifier, token address, or chain-qualified asset; discovery resolves canonical assets server-side."
          },
          "toToken": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Resolver-supported symbol, native identifier, token address, or chain-qualified asset; discovery resolves canonical assets server-side."
          },
          "fromAmount": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "protocol": {
            "type": "string",
            "enum": [
              "lifi",
              "relay"
            ]
          },
          "walletAddress": {
            "type": "string",
            "pattern": "^0x[a-fA-F0-9]{40}$"
          },
          "toAddress": {
            "type": "string",
            "pattern": "^0x[a-fA-F0-9]{40}$"
          },
          "slippage": {
            "type": "number",
            "minimum": 0.01,
            "maximum": 5
          },
          "expectedUpsideUsd": {
            "type": "number"
          },
          "riskBufferUsd": {
            "type": "number"
          },
          "healthFactor": {
            "type": "number"
          },
          "liquidationBufferPct": {
            "type": "number"
          },
          "safetyMode": {
            "type": "string",
            "enum": [
              "strict",
              "balanced"
            ]
          },
          "continuationId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "idempotencyKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "executionTrialProof": {
            "description": "Locally signed commercial owner challenge; no transaction or delegation authority.",
            "type": "object",
            "properties": {
              "issuedAt": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "signature": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "issuedAt",
              "signature"
            ]
          },
          "executionMode": {
            "type": "string",
            "enum": [
              "USER_SIGNED",
              "BOUNDED_AUTONOMOUS"
            ]
          },
          "sessionId": {
            "type": "string"
          },
          "sessionToken": {
            "type": "string"
          },
          "grantId": {
            "type": "string"
          }
        },
        "required": [
          "fromChainId",
          "toChainId",
          "fromToken",
          "toToken",
          "fromAmount"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "simulate_swap_execution",
      "inputSchema": {
        "type": "object",
        "properties": {
          "intentId": {
            "type": "string",
            "minLength": 1
          },
          "walletAddress": {
            "type": "string",
            "pattern": "^0x[a-fA-F0-9]{40}$"
          }
        },
        "required": [
          "intentId",
          "walletAddress"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "execute_swap",
      "inputSchema": {
        "type": "object",
        "properties": {
          "fromChainId": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "toChainId": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "fromToken": {
            "type": "string",
            "pattern": "^0x[a-fA-F0-9]{40}$",
            "description": "ERC-20 token contract address deployed on the corresponding chain. Do not pass a wallet/EOA; the token address and chain ID must match."
          },
          "toToken": {
            "type": "string",
            "pattern": "^0x[a-fA-F0-9]{40}$",
            "description": "ERC-20 token contract address deployed on the corresponding chain. Do not pass a wallet/EOA; the token address and chain ID must match."
          },
          "fromAmount": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "agentAddress": {
            "type": "string",
            "pattern": "^0x[a-fA-F0-9]{40}$"
          },
          "toAddress": {
            "type": "string",
            "pattern": "^0x[a-fA-F0-9]{40}$"
          },
          "nonce": {
            "type": "string"
          },
          "signature": {
            "type": "string"
          },
          "simulationId": {
            "type": "string",
            "minLength": 1
          },
          "intentId": {
            "type": "string"
          },
          "slippage": {
            "type": "number"
          },
          "protocol": {
            "type": "string",
            "enum": [
              "lifi",
              "relay"
            ]
          }
        },
        "required": [
          "fromChainId",
          "toChainId",
          "fromToken",
          "toToken",
          "fromAmount",
          "agentAddress",
          "toAddress",
          "nonce",
          "signature",
          "simulationId"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "confirm_swap",
      "inputSchema": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string"
          },
          "agentAddress": {
            "type": "string",
            "pattern": "^0x[a-fA-F0-9]{40}$"
          },
          "sessionToken": {
            "type": "string"
          },
          "feeEventId": {
            "type": "string"
          },
          "txHash": {
            "type": "string"
          }
        },
        "required": [
          "sessionId",
          "agentAddress",
          "sessionToken",
          "feeEventId",
          "txHash"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    }
  ],
  "verifiedContractCommit": "45196127e861f55fa3fb0e295dc4580a6bdfe4ad",
  "inputSchemaSource": "https://www.farmdash.one/.well-known/mcp.json",
  "verifiedAt": "2026-10-28"
}
