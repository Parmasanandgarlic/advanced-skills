{
  "sourceRepository": "hububstudio/farmdashbeta",
  "sourceCommit": "3b6a83dd5bfa239c85b68797bd27651294f335ab",
  "tools": [
    {
      "name": "get_swap_quote",
      "inputSchema": {
        "type": "object",
        "properties": {
          "fromChainId": {
            "type": "integer"
          },
          "toChainId": {
            "type": "integer"
          },
          "fromToken": {
            "type": "string",
            "pattern": "^0x[a-fA-F0-9]{40}$",
            "description": "ERC-20 token contract address deployed on the corresponding chain. Do not pass a wallet/EOA; the token address and chain ID must match."
          },
          "toToken": {
            "type": "string",
            "pattern": "^0x[a-fA-F0-9]{40}$",
            "description": "ERC-20 token contract address deployed on the corresponding chain. Do not pass a wallet/EOA; the token address and chain ID must match."
          },
          "fromAmount": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "protocol": {
            "type": "string",
            "enum": [
              "lifi",
              "relay"
            ]
          },
          "walletAddress": {
            "type": "string",
            "pattern": "^0x[a-fA-F0-9]{40}$"
          },
          "toAddress": {
            "type": "string",
            "pattern": "^0x[a-fA-F0-9]{40}$"
          },
          "slippage": {
            "type": "number",
            "minimum": 0.01,
            "maximum": 5
          },
          "expectedUpsideUsd": {
            "type": "number"
          },
          "riskBufferUsd": {
            "type": "number"
          },
          "healthFactor": {
            "type": "number"
          },
          "liquidationBufferPct": {
            "type": "number"
          },
          "safetyMode": {
            "type": "string",
            "enum": [
              "strict",
              "balanced"
            ]
          },
          "idempotencyKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "fromChainId",
          "toChainId",
          "fromToken",
          "toToken",
          "fromAmount"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "simulate_swap_execution",
      "inputSchema": {
        "type": "object",
        "properties": {
          "intentId": {
            "type": "string",
            "minLength": 1
          },
          "walletAddress": {
            "type": "string",
            "pattern": "^0x[a-fA-F0-9]{40}$"
          }
        },
        "required": [
          "intentId",
          "walletAddress"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "execute_swap",
      "inputSchema": {
        "type": "object",
        "properties": {
          "fromChainId": {
            "type": "integer"
          },
          "toChainId": {
            "type": "integer"
          },
          "fromToken": {
            "type": "string",
            "pattern": "^0x[a-fA-F0-9]{40}$",
            "description": "ERC-20 token contract address deployed on the corresponding chain. Do not pass a wallet/EOA; the token address and chain ID must match."
          },
          "toToken": {
            "type": "string",
            "pattern": "^0x[a-fA-F0-9]{40}$",
            "description": "ERC-20 token contract address deployed on the corresponding chain. Do not pass a wallet/EOA; the token address and chain ID must match."
          },
          "fromAmount": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "agentAddress": {
            "type": "string",
            "pattern": "^0x[a-fA-F0-9]{40}$"
          },
          "toAddress": {
            "type": "string",
            "pattern": "^0x[a-fA-F0-9]{40}$"
          },
          "nonce": {
            "type": "string"
          },
          "signature": {
            "type": "string"
          },
          "simulationId": {
            "type": "string",
            "minLength": 1
          },
          "intentId": {
            "type": "string"
          },
          "slippage": {
            "type": "number"
          },
          "protocol": {
            "type": "string",
            "enum": [
              "lifi",
              "relay"
            ]
          }
        },
        "required": [
          "fromChainId",
          "toChainId",
          "fromToken",
          "toToken",
          "fromAmount",
          "agentAddress",
          "toAddress",
          "nonce",
          "signature",
          "simulationId"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "confirm_swap",
      "inputSchema": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string"
          },
          "agentAddress": {
            "type": "string",
            "pattern": "^0x[a-fA-F0-9]{40}$"
          },
          "sessionToken": {
            "type": "string"
          },
          "feeEventId": {
            "type": "string"
          },
          "txHash": {
            "type": "string"
          }
        },
        "required": [
          "sessionId",
          "agentAddress",
          "sessionToken",
          "feeEventId",
          "txHash"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    }
  ]
}
